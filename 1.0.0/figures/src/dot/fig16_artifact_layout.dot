digraph fig16_artifact_layout {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];

  t [shape=plaintext, style="", fontsize=9, label=<<TABLE BORDER="1" COLOR="#3A3A3A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#FFFFFF"><TR><TD ALIGN="LEFT"><FONT FACE="Courier"><B>artifacts/&lt;profile&gt;/</B></FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── pools/&lt;ds&gt;/&lt;gen&gt;/seed&lt;k&gt;.parquet</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">pool windows (N, T, 3) + record</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── generators/&lt;ds&gt;/&lt;gen&gt;/…parquet</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">generator weights (VAE, Diffusion-TS, SDV)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── series/&lt;ds&gt;/&lt;method&gt;/seed&lt;k&gt;.parquet</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">t, value, how, window, piece, seam</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── records/&lt;ds&gt;/&lt;method&gt;/seed&lt;k&gt;.parquet</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">time, memory, hardware, diagnostics</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── fidelity/&lt;ds&gt;/&lt;method&gt;/seed&lt;k&gt;.parquet</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">all F-metrics (+ .cells.json)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── labels/&lt;ds&gt;/&lt;task&gt;.parquet</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">real test labels: split, row, y</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── utility/&lt;ds&gt;/&lt;method&gt;/seed&lt;k&gt;/</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">│   ├── cells.json</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">done cells with their fingerprints</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">│   ├── metrics.parquet</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">U-metrics per task × model × regime × split</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">│   ├── predictions.parquet</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">every prediction (scalar or vector)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">│   └── models.parquet</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">weights of every fitted model</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── tables/</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">timing, fidelity, utility, pools, cross_seed,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">│</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">datasets, inventory, hardware, config.json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── reports/</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">Markdown reports of the analysis:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">│   ├── REPORT.md</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">RQ0–RQ9, C1–C4, case study CS1–CS15</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">│   ├── OVERALL.md</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">overall leaderboard, robustness checks</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">│   ├── LEADERBOARD.md</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">ranks of every method per slice</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">│   └── METRIC_VALUES.md</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">metric values by reference, dataset, task, model, split</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── overall/</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">overall leaderboard tables, robustness checks</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── leaderboard/</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">rankings.parquet, ranks per slice, tests, stability</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── metric_values/</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">fidelity, utility: median and IQR over seeds</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">├── hypotheses/</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">RQ*, CS* global / per dataset, confirmatory</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier">└── errors.log</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7A7A7A">failed units (run continues)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="8">Parquet, zstd; float32 except series values (float64). Every unit file carries its unit_fp.</FONT></TD></TR></TABLE>>];
}
