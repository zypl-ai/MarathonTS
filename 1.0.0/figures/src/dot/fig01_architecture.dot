digraph fig01_architecture {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];

  t [shape=plaintext, style="", fontsize=9.5, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="5" CELLPADDING="5" COLOR="#3A3A3A"><TR><TD ALIGN="LEFT" VALIGN="MIDDLE" BORDER="0"><B>Execution</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8.5" COLOR="#7A7A7A">3 ways to run</FONT></TD><TD COLSPAN="3" BGCOLOR="#FFFFFF" STYLE="ROUNDED"><B>Docker</B><BR/><FONT POINT-SIZE="8">bench (PyTorch) · tsgm (TF)</FONT></TD><TD COLSPAN="3" BGCOLOR="#FFFFFF" STYLE="ROUNDED"><B>Colab notebooks</B><BR/><FONT POINT-SIZE="8">01_data … 07_hypotheses</FONT></TD><TD COLSPAN="2" BGCOLOR="#FFFFFF" STYLE="ROUNDED"><B>envs/</B><BR/><FONT POINT-SIZE="8">base · core · tsgm · sdv ·<br/>diffusion_ts · chronos · timesfm · timestral</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="MIDDLE" BORDER="0"><B>bench: infra</B><BR ALIGN="LEFT"/></TD><TD COLSPAN="1" BGCOLOR="#EDEDED" STYLE="ROUNDED"><B>run.py</B><BR/><FONT POINT-SIZE="8">stage driver</FONT></TD><TD COLSPAN="2" BGCOLOR="#EDEDED" STYLE="ROUNDED"><B>config.py</B><BR/><FONT POINT-SIZE="8">Config, profiles,<br/>unit fingerprints</FONT></TD><TD COLSPAN="2" BGCOLOR="#EDEDED" STYLE="ROUNDED"><B>registry.py</B><BR/><FONT POINT-SIZE="8">10 name registries</FONT></TD><TD COLSPAN="2" BGCOLOR="#EDEDED" STYLE="ROUNDED"><B>storage.py · load.py</B><BR/><FONT POINT-SIZE="8">Parquet I/O, reload</FONT></TD><TD COLSPAN="1" BGCOLOR="#EDEDED" STYLE="ROUNDED"><B>timing.py</B><BR/><FONT POINT-SIZE="8">time, memory</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="MIDDLE" BORDER="0"><B>bench: stages</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8.5" COLOR="#7A7A7A">raw → prepare → pools →<br/>generate → fidelity →<br/>utility → collect</FONT></TD><TD COLSPAN="1" BGCOLOR="#D6E6F4" STYLE="ROUNDED"><B>datasets.py<br/>data.py</B><BR/><FONT POINT-SIZE="8">raw → hourly →<br/>split → windows</FONT></TD><TD COLSPAN="1" BGCOLOR="#D6E6F4" STYLE="ROUNDED"><B>tasks.py</B><BR/><FONT POINT-SIZE="8">14 tasks,<br/>features, labels</FONT></TD><TD COLSPAN="2" BGCOLOR="#F9DCC2" STYLE="ROUNDED"><B>generators/</B><BR/><FONT POINT-SIZE="8">pool: tsgm_vae, sdv_par,<br/>real_windows · long:<br/>diffusion_ts, chronos,<br/>timesfm, timestral</FONT></TD><TD COLSPAN="1" BGCOLOR="#FCEFB4" STYLE="ROUNDED"><B>assemblers.py<br/>joiners.py</B><BR/><FONT POINT-SIZE="8">10 assemblers,<br/>3 seam joiners</FONT></TD><TD COLSPAN="1" BGCOLOR="#FCEFB4" STYLE="ROUNDED"><B>methods.py</B><BR/><FONT POINT-SIZE="8">16 methods (min),<br/>4 of them published</FONT></TD><TD COLSPAN="1" BGCOLOR="#F6D5DA" STYLE="ROUNDED"><B>fidelity.py</B><BR/><FONT POINT-SIZE="8">F1–F12, 83 metrics<br/>× 3 references</FONT></TD><TD COLSPAN="1" BGCOLOR="#D5ECD0" STYLE="ROUNDED"><B>utility.py<br/>models.py</B><BR/><FONT POINT-SIZE="8">TSTR / TRTR,<br/>linear, MLP, GBDT</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="MIDDLE" BORDER="0"><B>Libraries</B><BR ALIGN="LEFT"/></TD><TD COLSPAN="2" BGCOLOR="#F9DCC2" STYLE="ROUNDED"><B>external/Diffusion-TS</B><BR/><FONT POINT-SIZE="8">official code, pinned commit</FONT></TD><TD COLSPAN="3" BGCOLOR="#FCEFB4" STYLE="ROUNDED"><B>zseries assembler</B><BR/><FONT POINT-SIZE="8">vae_zseries: proprietary method of zypl.ai (under development),<br/>results published, code not in the repository</FONT></TD><TD COLSPAN="3" BGCOLOR="#FFFFFF" STYLE="ROUNDED">PyTorch · XGBoost · scikit-learn · statsmodels · OR-Tools · elkai · tsgm · Chronos · TimesFM · Timestral</TD></TR><TR><TD ALIGN="LEFT" VALIGN="MIDDLE" BORDER="0"><B>Storage</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8.5" COLOR="#7A7A7A">Parquet (zstd)</FONT></TD><TD COLSPAN="3" BGCOLOR="#EDEDED" STYLE="ROUNDED"><B>data/</B><BR/><FONT POINT-SIZE="8">raw/ · processed/&lt;profile&gt;/</FONT></TD><TD COLSPAN="5" BGCOLOR="#EDEDED" STYLE="ROUNDED"><B>artifacts/&lt;profile&gt;/</B><BR/><FONT POINT-SIZE="8">pools · generators · series · records · fidelity · labels ·<br/>utility · tables · reports · overall · leaderboard ·<br/>metric_values · hypotheses</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="MIDDLE" BORDER="0"><B>hypotheses</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="8.5" COLOR="#7A7A7A">reads tables only (CPU)</FONT></TD><TD COLSPAN="1" BGCOLOR="#E3DAF0" STYLE="ROUNDED"><B>overall.py</B><BR/><FONT POINT-SIZE="8">overall leaderboard</FONT></TD><TD COLSPAN="1" BGCOLOR="#E3DAF0" STYLE="ROUNDED"><B>leaderboard.py</B><BR/><FONT POINT-SIZE="8">ranking in every slice</FONT></TD><TD COLSPAN="1" BGCOLOR="#E3DAF0" STYLE="ROUNDED"><B>metric_values.py</B><BR/><FONT POINT-SIZE="8">metric values<br/>by slice</FONT></TD><TD COLSPAN="1" BGCOLOR="#E3DAF0" STYLE="ROUNDED"><B>questions.py</B><BR/><FONT POINT-SIZE="8">RQ0–RQ9, C1–C4</FONT></TD><TD COLSPAN="1" BGCOLOR="#E3DAF0" STYLE="ROUNDED"><B>catalog.py</B><BR/><FONT POINT-SIZE="8">loaders,<br/>case study CS</FONT></TD><TD COLSPAN="1" BGCOLOR="#E3DAF0" STYLE="ROUNDED"><B>engine.py · stats.py</B><BR/><FONT POINT-SIZE="8">noise, paired effects,<br/>verdicts; Wilcoxon, TOST,<br/>bootstrap, Holm/BH</FONT></TD><TD COLSPAN="2" BGCOLOR="#E3DAF0" STYLE="ROUNDED"><B>reports/</B><BR/><FONT POINT-SIZE="8">OVERALL.md · LEADERBOARD.md<br/>METRIC_VALUES.md · REPORT.md</FONT></TD></TR></TABLE>>];
}
