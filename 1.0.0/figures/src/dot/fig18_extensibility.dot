digraph fig18_extensibility {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];


  rankdir=LR; ranksep=0.5;
  pl [label="plugin file\nmy_plugins.py\n@register(name)", shape=note, style=filled, fillcolor="#FFFFFF"];
  cf [label=<<b>Config</b><br/><font point-size="8.5">plugins · pool_suites · extra_assemblers<br/>extra_joiners · long_methods · extra={…}</font>>, fillcolor="#EDEDED"];
  t [shape=plaintext, style="", margin=0, fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3A3A3A"><TR><TD BGCOLOR="#EDEDED" ALIGN="LEFT"><B>registry</B></TD><TD BGCOLOR="#EDEDED" ALIGN="LEFT"><B>interface</B></TD><TD BGCOLOR="#EDEDED" ALIGN="LEFT"><B>effect when registered</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#D6E6F4"><B>datasets</B></TD><TD ALIGN="LEFT">load(cfg) → hourly pd.Series</TD><TD ALIGN="LEFT">selectable by name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#D6E6F4"><B>tasks</B></TD><TD ALIGN="LEFT">fit(train) → params; labels(values, params)</TD><TD ALIGN="LEFT">new utility task (all methods)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9DCC2"><B>pool_generators</B></TD><TD ALIGN="LEFT">fit, sample(n), state, load_state</TD><TD ALIGN="LEFT">whole assembly suite on the new pool</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9DCC2"><B>long_generators</B></TD><TD ALIGN="LEFT">fit, generate, state, load_state</TD><TD ALIGN="LEFT">new method, compared in RQ2 and ranked</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><B>assemblers</B></TD><TD ALIGN="LEFT">assemble(pool, ctx) → path, info</TD><TD ALIGN="LEFT">&lt;prefix&gt;_&lt;name&gt; on every pool</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><B>joiners</B></TD><TD ALIGN="LEFT">windows_needed; join(W, L) → X, seams, src</TD><TD ALIGN="LEFT">&lt;prefix&gt;_&lt;assembler&gt;_&lt;name&gt;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><B>methods</B></TD><TD ALIGN="LEFT">pool + assembler (+ joiner) | long-series generator</TD><TD ALIGN="LEFT">explicit method definition</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#D5ECD0"><B>models</B></TD><TD ALIGN="LEFT">fit, predict, state, load_state, kinds</TD><TD ALIGN="LEFT">fitted in TSTR and TRTR</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6D5DA"><B>fidelity_metrics</B></TD><TD ALIGN="LEFT">fn(ctx) → {metric: value} + orientation</TD><TD ALIGN="LEFT">new F-columns × 3 references, ranked</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#D5ECD0"><B>utility_metrics</B></TD><TD ALIGN="LEFT">fn(y, pred, ctx) → dict</TD><TD ALIGN="LEFT">new U-columns</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>hypotheses: tests</B></TD><TD ALIGN="LEFT">fn(d, margin) or fn(z) → dict</TD><TD ALIGN="LEFT">columns in every comparison table</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>hypotheses: catalog</B></TD><TD ALIGN="LEFT">fn(tables, cfg) → global, per_dataset, extra</TD><TD ALIGN="LEFT">case-study section in REPORT.md</TD></TR></TABLE>>];
  pl -> t [label=" registers"]; cf -> t [label=" selects by name"];
  {rank=same; pl; cf}

}
