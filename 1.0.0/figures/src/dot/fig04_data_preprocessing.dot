digraph fig04_data_preprocessing {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];


  node [fillcolor="#D6E6F4"];
  src [shape=folder, style=filled, label="9 public datasets\nETTh1 · Electricity · Household · PJM · Beijing PM2.5\nJena · Metro · Bike · Bitcoin\n(CSV / TXT; 1 min – 1 h)"];
  raw [label=<<b>raw</b><br/>lossless CSV → Parquet (float64, all columns);<br/>original removed only after row-count check>];
  hr  [label=<<b>Univariate hourly series</b><br/>hourly mean (Electricity, Household, Jena) ·<br/>last log-price (Bitcoin) · as is (others)>];
  gap [label=<<b>Gaps</b><br/>interpolate ≤ 6 h; longer stay NaN<br/>(windows with NaN are dropped)>];
  cut [label=<<b>Length</b><br/>last max_points points<br/>(min: 10 000; max: full series)>];
  spl [label=<<b>Temporal split with embargo 168 h</b><br/>train | val | OOT = 50/25/25 (min) · 60/20/20 (max)>];
  sc  [label=<<b>Fit on train only</b><br/>min–max scaler lo, hi · T = 168 · K = round(n_train / T)<br/>N = max(300, 2K) · stride s ≈ (n_train − T)/5000<br/>task thresholds (target_params.json)>, fillcolor="#FFFFFF", color="#B03A2E", penwidth=1.3];
  ch  [label=<<b>Channels</b> (L, 3) in [0, 1]<br/>0: (x − lo)/(hi − lo)<br/>1, 2: (sin + 1)/2, (cos + 1)/2 of hour-of-week (168)>];
  win [label=<<b>Windows</b> (n, T, 3), stride s<br/>train core | embargo (168 rows) | holdout (last 10%)>];

  src -> raw -> hr -> gap -> cut -> spl -> sc -> ch -> win;

  node [fillcolor="#FFFFFF", fontsize=8.5];
  u1 [label="generator training\n(core windows)", fillcolor="#F9DCC2"];
  u2 [label="early stopping\n(holdout windows)", fillcolor="#F9DCC2"];
  u3 [label="reference statistics\n(full train)", fillcolor="#FCEFB4"];
  u4 [label="fidelity references\n(val primary · train, OOT;\nreal units)", fillcolor="#F6D5DA"];
  u5 [label="utility test rows\n(val, OOT)", fillcolor="#D5ECD0"];
  win -> u1; win -> u2; ch -> u3; spl -> u4 [label=" val, train, OOT"]; spl -> u5 [label=" val, OOT", minlen=2];
  meta [shape=note, style=filled, fillcolor="#EDEDED", label="<ds>.meta.parquet\nlo, hi, T, K, N, s, boundaries,\ndata_key = hash(split, max_points, T)"];
  sc -> meta [style=dashed, color="#7A7A7A"];

}
