digraph fig08_method_family {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];


  nodesep=0.35; ranksep=0.45;
  node [shape=plaintext, style="", margin=0];
  pool [shape=cylinder, style=filled, fillcolor="#EDEDED", margin="0.1,0.05",
        label="pool of N VAE windows\n(shared per dataset × seed)"];
  trn  [shape=box, style="rounded,filled", fillcolor="#D6E6F4", margin="0.1,0.05", label="real train"];
  A [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3A3A3A" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>A · Selection and order (same pool) — 10 methods</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3D27A"><B>vae_zseries</B></TD><TD ALIGN="LEFT" BGCOLOR="#F3D27A"><FONT POINT-SIZE="8.5"><B>zseries: proprietary method of zypl.ai (under development),<BR ALIGN="LEFT"/>case study (published results)</B><BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">vae_rand</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">K random windows, random order (control)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">vae_rand_b</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">second random order, noise estimate (mid, max)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">vae_greedy</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">nearest neighbour by the jump at the seam</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">vae_atsp</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">asymmetric TSP over pool (LKH), cheapest K-run</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">vae_pctsp</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">prize-collecting TSP (OR-Tools)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">vae_mbb</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">matched-block bootstrap, Gaussian kernel of the jump</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">vae_knn</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">k-NN resampling, weights ∝ 1/rank, k = √N</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">vae_quilting</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">image quilting: choice by overlap error + min-error cut</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">vae_herding</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">kernel herding to train windows (MMD)</FONT></TD></TR></TABLE>>];
  B [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3A3A3A" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>B · Seam joiners on the vae_zseries path — 3 methods</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">crossfade</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">Hann-window blend of the overlap</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">wsola</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">shift ≤ 12 to best correlation, then blend</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCEFB4">quilt</TD><TD ALIGN="LEFT" BGCOLOR="#FCEFB4"><FONT POINT-SIZE="8.5">cut at minimum-difference point</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#7A7A7A">overlap 12 points; vae_zseries_{xfade,wsola,quilt}: published results;<br/>max: over every assembler but random and vae_quilting</FONT></TD></TR></TABLE>>];
  Cc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3A3A3A" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>C · Long-series generators (no pool) — 4 methods</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9DCC2">diffusion_ts</TD><TD ALIGN="LEFT" BGCOLOR="#F9DCC2"><FONT POINT-SIZE="8.5">Diffusion-TS, autoregressive infill (context T/2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9DCC2">chronos</TD><TD ALIGN="LEFT" BGCOLOR="#F9DCC2"><FONT POINT-SIZE="8.5">Chronos-T5-small, zero-shot, context 512</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9DCC2">timesfm</TD><TD ALIGN="LEFT" BGCOLOR="#F9DCC2"><FONT POINT-SIZE="8.5">TimesFM 3.0, zero-shot median forecast, all train</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9DCC2">timestral</TD><TD ALIGN="LEFT" BGCOLOR="#F9DCC2"><FONT POINT-SIZE="8.5">Timestral 209M, zero-shot median forecast, all train</FONT></TD></TR></TABLE>>];
  R [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3A3A3A" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Reference (not a method)</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#D5ECD0">real</TD><TD ALIGN="LEFT" BGCOLOR="#D5ECD0"><FONT POINT-SIZE="8.5">OOT series (fidelity reference); real-train model (TRTR)</FONT></TD></TR></TABLE>>];
  out [shape=box, style="rounded,filled", fillcolor="#FFFFFF", penwidth=1.2, margin="0.12,0.06",
       label="17 methods (min: 16, without vae_rand_b; 4 of them published results) × 10 seeds × 9 datasets\n→ one series per unit, length K·T; real units + hour-of-week, window / piece id, seam flag"];
  pool -> A; A -> B [label=" path of vae_zseries"];
  trn -> Cc [label=" fit / context"];
  {rank=same; pool; trn}
  {rank=same; A; Cc}
  A -> out; B -> out; Cc -> out;
  R -> out [style=invis];
  Cc -> R [style=invis];

}
