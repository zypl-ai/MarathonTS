digraph fig02_stage_pipeline {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];


  node [width=2.6];
  raw [label=<<b>0 · raw</b><br/><font point-size="8.5">download, CSV/TXT → lossless Parquet</font>>, fillcolor="#D6E6F4"];
  prep [label=<<b>1 · prepare</b><br/><font point-size="8.5">hourly series, gap fill, last max_points,<br/>temporal split, scaler, T, K, N</font>>, fillcolor="#D6E6F4"];
  tgt [label=<<b>1a · targets (manual, once)</b><br/><font point-size="8.5">propose task thresholds on train<br/>→ committed target_params.json</font>>, fillcolor="#D6E6F4"];
  pools [label=<<b>2 · pools</b><br/><font point-size="8.5">fit pool generator (own env),<br/>sample N windows per seed</font>>, fillcolor="#F9DCC2"];
  gen [label=<<b>3 · generate</b><br/><font point-size="8.5">12 methods (min; published results skipped): assemble K·T series from pools;<br/>run long-series generators (Diffusion-TS, Chronos, TimesFM, Timestral)</font>>, fillcolor="#FCEFB4"];
  fid [label=<<b>4 · fidelity</b><br/><font point-size="8.5">F1–F12 vs real val, train, OOT<br/>(+ real reference, @len)</font>>, fillcolor="#F6D5DA"];
  utl [label=<<b>5 · utility</b><br/><font point-size="8.5">labels; TSTR &amp; TRTR × 14 tasks × 3 models<br/>× {val, OOT}</font>>, fillcolor="#D5ECD0"];
  col [label=<<b>6 · collect</b><br/><font point-size="8.5">merge unit files into tables</font>>, fillcolor="#EDEDED"];
  sci [label=<<b>7 · hypotheses</b><br/><font point-size="8.5">leaderboard, ranking, metric values, RQ0–RQ9, C1–C4,<br/>case study → reports/: OVERALL.md, LEADERBOARD.md,<br/>METRIC_VALUES.md, REPORT.md</font>>, fillcolor="#E3DAF0"];

  raw -> prep -> pools -> gen -> fid -> utl -> col -> sci;
  prep -> tgt [style=dashed, arrowhead=none];
  tgt -> utl [style=dashed, label=" thresholds", constraint=false];

  node [width=0, shape=cylinder, style=filled, fillcolor="#EDEDED", fontsize=8.5];
  a0 [label="data/raw/<ds>/*.parquet"];
  a1 [label="data/processed/<profile>/<ds>.parquet\n+ .meta.parquet (data_key)"];
  a2 [label="pools/<ds>/<gen>/seed<k>\ngenerators/ (weights)"];
  a3 [label="series/, records/\n(time, memory, hardware)"];
  a4 [label="fidelity/<ds>/<method>/seed<k>"];
  a5 [label="labels/, utility/…/metrics,\npredictions, models"];
  a6 [label="tables/*.parquet\nconfig.json, hardware"];
  a7 [label="reports/*.md\noverall/, leaderboard/,\nmetric_values/,\nhypotheses/RQ*, CS*, confirmatory"];
  {rank=same; raw; a0} {rank=same; prep; a1} {rank=same; pools; a2} {rank=same; gen; a3}
  {rank=same; fid; a4} {rank=same; utl; a5} {rank=same; col; a6} {rank=same; sci; a7}
  edge [style=dashed, color="#7A7A7A", arrowsize=0.5];
  raw -> a0; prep -> a1; pools -> a2; gen -> a3; fid -> a4; utl -> a5; col -> a6; sci -> a7;

  node [shape=plaintext, style="", fontsize=8.5, fontcolor="#7A7A7A"];
  e1 [label="env: base"]; e2 [label="env: base"]; e3 [label="env: tsgm / sdv\n(TensorFlow, no torch)"];
  e4 [label="env: core\n(+ diffusion_ts, chronos,\ntimesfm, timestral)"]; e5 [label="env: core"]; e6 [label="env: core"];
  e7 [label="env: core"]; e8 [label="env: core (CPU)"];
  {rank=same; raw; e1} {rank=same; prep; e2} {rank=same; pools; e3} {rank=same; gen; e4}
  {rank=same; fid; e5} {rank=same; utl; e6} {rank=same; col; e7} {rank=same; sci; e8}
  edge [style=invis];
  e1 -> raw; e2 -> prep; e3 -> pools; e4 -> gen; e5 -> fid; e6 -> utl; e7 -> col; e8 -> sci;

}
