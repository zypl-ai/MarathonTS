digraph fig10_utility_pipeline {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];


  node [fillcolor="#D5ECD0"];
  rtr [label="real train\n(values, hour-of-week)", fillcolor="#D6E6F4"];
  syn [label="synthetic series of method m\n(K·T, real units)", fillcolor="#FCEFB4"];
  rte [label="real val and OOT", fillcolor="#D6E6F4"];
  thr [label=<<b>Task parameters</b> (frozen, from train)<br/>target_params.json: quantile thresholds>, fillcolor="#FFFFFF", color="#B03A2E", penwidth=1.3];

  subgraph cluster_fe { label=<<b>make_xy</b> — computed on each series separately (no lags across series)>; style="rounded,filled"; fillcolor="#FFFFFF"; color="#3A3A3A";
    fr [label="features: x_t, x_t − x_{t−l}, l ∈ {1,2,3,6,12,24,48,168},\nsin/cos hour-of-week  (11 features)"];
    lb [label="labels: 14 tasks (U2.1–U2.9)\nclf · mc · reg · qreg · ms · vol"];
  }
  rtr -> fr; syn -> fr; rte -> fr; thr -> lb;

  subgraph cluster_r { label=<<b>Regime R — TRTR</b> (pseudo-method real, once per seed)>; style="rounded,filled"; fillcolor="#FFFFFF"; color="#3A3A3A";
    mr [label="fit on real train"]; }
  subgraph cluster_s { label=<<b>Regime S — TSTR</b> (every method, every seed)>; style="rounded,filled"; fillcolor="#FFFFFF"; color="#3A3A3A";
    ms [label="fit on synthetic only"]; }
  lb -> mr; lb -> ms; fr -> mr; fr -> ms;

  mdl [label=<<b>Models</b> (fixed configs, model_configs.json)<br/>linear (PyTorch, L-BFGS / ridge) · MLP 64→32 (PyTorch)<br/>GBDT (XGBoost); standardisation fitted on own training set>, fillcolor="#FFFFFF"];
  mdl -> mr [style=dashed]; mdl -> ms [style=dashed];

  pc [label=<<b>Prior correction</b> (clf, mc): class probabilities<br/>P(c|x) ∝ P<sub>balanced</sub>(c|x) · share<sub>train</sub>(c)>];
  ev [label=<<b>Predict on the same real test rows</b><br/>val and OOT>];
  mr -> ev; ms -> ev; rte -> ev [style=dashed, label=" X, y"]; ev -> pc;
  met [label=<<b>Metrics</b><br/>binary: AUC, PR AUC, Brier, log-loss, ECE, F1, lift<br/>multiclass: macro AUC, log-loss, macro F1<br/>regression: MAE, RMSE, MASE, sMAPE, extremes<br/>quantile: pinball, coverage, crossings · multistep: MASE>];
  pc -> met;
  o1 [shape=cylinder, style=filled, fillcolor="#EDEDED", label="utility/<ds>/<m>/seed<k>/\nmetrics · predictions · models"];
  met -> o1;
  tr [label=<<b>Comparison</b> (hypothesis tests): TSTR(m) vs TRTR, TSTR(m) vs TSTR(m′)<br/>transfer ratio, row-level block bootstrap on predictions>, fillcolor="#E3DAF0"];
  o1 -> tr;

}
