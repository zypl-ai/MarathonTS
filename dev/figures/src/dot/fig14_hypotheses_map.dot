digraph fig14_hypotheses_map {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];

  t [shape=plaintext, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#3A3A3A"><TR><TD BGCOLOR="#EDEDED" ALIGN="LEFT"><B>id</B></TD><TD BGCOLOR="#EDEDED" ALIGN="LEFT"><B>question</B></TD><TD BGCOLOR="#EDEDED" ALIGN="LEFT"><B>evidence</B></TD><TD BGCOLOR="#EDEDED" ALIGN="LEFT"><B>analysis / compared with</B></TD><TD BGCOLOR="#EDEDED" ALIGN="LEFT"><B>note</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ0</B></TD><TD ALIGN="LEFT">benchmark validity: noise, real-data ceiling, which metrics discriminate, redundancy</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">all F (3 references), TSTR</TD><TD ALIGN="LEFT">rand vs rand_b (mid, max); real; Friedman</TD><TD> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ1</B></TD><TD ALIGN="LEFT"><B>ranking of every method in every slice</B></TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">all leaves: F × reference, U × split, cost</TD><TD ALIGN="LEFT">all methods</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">leaderboard</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ2</B></TD><TD ALIGN="LEFT">assembly from a window pool vs generators of long series</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">F (val, OOT), TSTR all tasks</TD><TD ALIGN="LEFT">long gen. vs rand, assembly median</TD><TD> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ3</B></TD><TD ALIGN="LEFT">inside assembly: window selection × seam processing</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">F (val, OOT), TSTR all tasks</TD><TD ALIGN="LEFT">vs random path; seam-processing contrasts</TD><TD> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ4</B></TD><TD ALIGN="LEFT">does fidelity predict utility (which metrics, which reference)</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">F (3 references) ↔ transfer ratio</TD><TD ALIGN="LEFT">Spearman across methods</TD><TD> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ5</B></TD><TD ALIGN="LEFT">gap to real data; stability over time and model class; decision transfer</TD><TD ALIGN="LEFT" BGCOLOR="#D5ECD0">TSTR / TRTR, U6</TD><TD ALIGN="LEFT">real (TRTR); Kendall τ</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">(c) max only</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ6</B></TD><TD ALIGN="LEFT">speed and cost: training, generation, memory; quality–time Pareto</TD><TD ALIGN="LEFT" BGCOLOR="#EDEDED">time, memory</TD><TD ALIGN="LEFT">all methods</TD><TD> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ7</B></TD><TD ALIGN="LEFT">moderators: dataset properties and family differences</TD><TD ALIGN="LEFT" BGCOLOR="#EDEDED">dataset descriptors</TD><TD ALIGN="LEFT">effects of RQ2, RQ3</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">explor.</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ8</B></TD><TD ALIGN="LEFT">class balance: shares of every classification task, rare events</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">F8.1, F11; TSTR ECE</TD><TD ALIGN="LEFT">vs random path; long gen. vs assembly median</TD><TD> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>RQ9</B></TD><TD ALIGN="LEFT">extremes: tails, outliers, block maxima / minima</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">F1 tails, F2.4, F7.4, F12; extreme error, rare PR AUC</TD><TD ALIGN="LEFT">vs random path; long gen. vs assembly median</TD><TD> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><FONT COLOR="#B03A2E"><B>C1–C4</B></FONT></TD><TD ALIGN="LEFT"><B>confirmatory: methods differ; long vs assembly; selection; seam processing</B></TD><TD ALIGN="LEFT" BGCOLOR="#D5ECD0">U2.1 AUC, U2.6 MASE (TSTR, linear, OOT)</TD><TD ALIGN="LEFT">Friedman; assembly median; contrasts</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">confirm.</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3DAF0"><B>CS1–CS15</B></TD><TD ALIGN="LEFT">case study of one method (default vae_zseries) vs its controls and alternatives</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">F (val), TSTR</TD><TD ALIGN="LEFT">vae_rand, A, B, C</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">secondary</FONT></TD></TR><TR><TD COLSPAN="5" ALIGN="LEFT"><FONT POINT-SIZE="8">Evidence colour: utility TSTR/TRTR (green), cost and descriptors (grey), fidelity and utility together (white). F = fidelity metric groups (Fig. 12); A, B, C = method groups of Fig. 8.<BR ALIGN="LEFT"/>Confirmatory family: joint Holm over C1–C4 in both cells. Other questions: BH within a question; RQ7 exploratory. The case study is secondary.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
