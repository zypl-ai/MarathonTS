digraph fig15_incremental_recompute {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];


  rankdir=LR; nodesep=0.18; ranksep=0.42;
  node [fontsize=9];
  dk  [label="processed data\ndata_key: split, max_points, T", fillcolor="#D6E6F4"];
  wl  [label="training windows\nmax_windows, holdout_frac", fillcolor="#D6E6F4"];
  tp  [label="target_params*.json", shape=note, style=filled, fillcolor="#EDEDED"];
  mc  [label="model_configs.json", shape=note, style=filled, fillcolor="#EDEDED"];
  gf  [label="pool generator fit\n(VAE weights)", fillcolor="#F9DCC2"];
  gs  [label="pool sample\npool_size, pool_mult", fillcolor="#F9DCC2"];
  df  [label="Diffusion-TS fit", fillcolor="#F9DCC2"];
  ch  [label="pretrained load\n(Chronos, TimesFM, Timestral)", fillcolor="#F9DCC2"];
  sr  [label="series of method m\n+ assembler/joiner settings\n(e.g. knn_k, mbb_*, join_overlap)", fillcolor="#FCEFB4"];
  fi  [label="fidelity unit\n+ fidelity_*, disc_epochs", fillcolor="#F6D5DA"];
  lb  [label="labels", fillcolor="#D5ECD0"];
  ut  [label="utility unit (TSTR)\n+ tasks, models, hpo", fillcolor="#D5ECD0"];
  tr  [label="TRTR (real)", fillcolor="#D5ECD0"];
  dk -> wl -> gf -> gs -> sr; wl -> df -> sr; dk -> ch -> sr;
  sr -> fi; tp -> fi; tp -> lb; dk -> lb;
  sr -> ut; lb -> ut; mc -> ut; lb -> tr; mc -> tr;
  note [shape=note, style=filled, fillcolor="#FFFFFF", fontsize=8.5,
        label="unit_fp = hash(processed data, own settings,\nrelevant JSON files, upstream unit_fp).\nA unit is skipped if its files exist with the same unit_fp;\nfidelity and utility: per cell (cells.json).\nExample: changing knn_k recomputes vae_knn series\nand their fidelity/utility; pools, VAE, other methods,\nlabels, TRTR and real fidelity are kept."];

}
