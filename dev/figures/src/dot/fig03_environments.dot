digraph fig03_environments {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];


  compound=true;
  subgraph cluster_tf { label=<<b>env tsgm</b> (Docker target <i>tsgm</i>, Colab 02_pools)<br/><font point-size="8.5">TensorFlow + Keras 3 + tsgm 0.1.0, no torch</font>>;
    style="rounded,filled"; fillcolor="#F9DCC2"; color="#3A3A3A";
    vae [label="pools --pool-generators tsgm_vae\nfit β-VAE, sample N windows"];
  }
  subgraph cluster_sdv { label=<<b>env sdv</b> (optional)>; style="rounded,filled"; fillcolor="#F9DCC2"; color="#3A3A3A";
    sdv [label="pools --pool-generators sdv_par"];
  }
  subgraph cluster_core { label=<<b>env core</b> (Docker target <i>bench</i>, Colab 03–07)<br/><font point-size="8.5">PyTorch (CUDA or CPU), scikit-learn, XGBoost, statsmodels, OR-Tools, elkai</font>>;
    style="rounded,filled"; fillcolor="#FCEFB4"; color="#3A3A3A";
    g [label="generate\nall stitchings of the pool"];
    subgraph cluster_dts { label="+ diffusion_ts (einops, repo code)"; style="rounded,dashed"; color="#7A7A7A"; fillcolor="#FFFFFF";
      dts [label="generate --methods diffusion_ts"]; }
    subgraph cluster_chr { label="+ chronos (chronos-forecasting)"; style="rounded,dashed"; color="#7A7A7A"; fillcolor="#FFFFFF";
      chr [label="generate --methods chronos"]; }
    subgraph cluster_tfm { label="+ timesfm (timesfm 3.0.2)"; style="rounded,dashed"; color="#7A7A7A"; fillcolor="#FFFFFF";
      tfm [label="generate --methods timesfm"]; }
    subgraph cluster_tst { label="+ timestral (timestral)"; style="rounded,dashed"; color="#7A7A7A"; fillcolor="#FFFFFF";
      tst [label="generate --methods timestral"]; }
    f [label="fidelity · utility · collect"];
    s [label="hypotheses"];
    g -> f; dts -> f; chr -> f; tfm -> f; tst -> f; f -> s;
  }
  subgraph cluster_base { label=<<b>env base</b>  numpy, scipy, pandas, pyarrow>; style="rounded,filled"; fillcolor="#D6E6F4"; color="#3A3A3A";
    rp [label="raw · prepare"];
  }
  dp [shape=cylinder, style=filled, fillcolor="#EDEDED", label="data/processed\n(Parquet)"];
  pp [shape=cylinder, style=filled, fillcolor="#EDEDED", label="artifacts/pools\n(N, T, 3) per seed"];
  sp [shape=cylinder, style=filled, fillcolor="#EDEDED", label="artifacts/series, records"];
  rp -> dp;
  dp -> vae; dp -> sdv; dp -> g; dp -> dts; dp -> chr; dp -> tfm; dp -> tst;
  vae -> pp; sdv -> pp;
  pp -> g [label=" read only"];
  g -> sp; dts -> sp; chr -> sp; tfm -> sp; tst -> sp;
  note [shape=note, style=filled, fillcolor="#FFFFFF", fontsize=8.5,
        label="Environments communicate only through Parquet artifacts.\nTensorFlow is never imported in env core;\na generator whose modules are missing is skipped\nwith a hint, not an error (run_in_env in Colab)."];

}
