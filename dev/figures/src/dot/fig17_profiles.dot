digraph fig17_profiles {
  rankdir=TB;

  graph [fontname="Helvetica", fontsize=11, pad=0.15, nodesep=0.28, ranksep=0.38, newrank=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF",
         color="#3A3A3A", penwidth=0.8, margin="0.10,0.05"];
  edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", penwidth=0.8, arrowsize=0.6];

  t [shape=plaintext, style="", fontsize=9, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3A3A3A"><TR><TD BGCOLOR="#EDEDED"><B>setting</B></TD><TD BGCOLOR="#EDEDED"><B>min (default)</B></TD><TD BGCOLOR="#EDEDED"><B>mid</B></TD><TD BGCOLOR="#EDEDED"><B>max</B></TD></TR><TR><TD ALIGN="LEFT"><B>methods</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">16 (no vae_rand_b)</TD><TD ALIGN="LEFT" BALIGN="LEFT">17</TD><TD ALIGN="LEFT" BALIGN="LEFT">35: + seam processing of every assembler<br/>but random and vae_quilting</TD></TR><TR><TD ALIGN="LEFT"><B>pool size N</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">max(300, 2K) = 300</TD><TD ALIGN="LEFT" BALIGN="LEFT">as min</TD><TD ALIGN="LEFT" BALIGN="LEFT">max(300, 2K)</TD></TR><TR><TD ALIGN="LEFT"><B>series length, split</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">last 10 000 pts; 50/25/25</TD><TD ALIGN="LEFT" BALIGN="LEFT">as min</TD><TD ALIGN="LEFT" BALIGN="LEFT">full series; 60/20/20</TD></TR><TR><TD ALIGN="LEFT"><B>VAE trainings</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">1 per dataset (9)</TD><TD ALIGN="LEFT" BALIGN="LEFT">1 per seed (90)</TD><TD ALIGN="LEFT" BALIGN="LEFT">1 per seed (90)</TD></TR><TR><TD ALIGN="LEFT"><B>Diffusion-TS trainings</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">1 per dataset (9)</TD><TD ALIGN="LEFT" BALIGN="LEFT">1 per dataset (9)</TD><TD ALIGN="LEFT" BALIGN="LEFT">1 per seed (90)</TD></TR><TR><TD ALIGN="LEFT"><B>hyper-parameter search</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">no</TD><TD ALIGN="LEFT" BALIGN="LEFT">no</TD><TD ALIGN="LEFT" BALIGN="LEFT">grid on tail of own train (TSTR: synthetic)</TD></TR><TR><TD ALIGN="LEFT"><B>Chronos</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">t5-small</TD><TD ALIGN="LEFT" BALIGN="LEFT">t5-small</TD><TD ALIGN="LEFT" BALIGN="LEFT">t5-base</TD></TR><TR><TD ALIGN="LEFT"><B>MLP tasks</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">U2.1 only</TD><TD ALIGN="LEFT" BALIGN="LEFT">U2.1 only</TD><TD ALIGN="LEFT" BALIGN="LEFT">all tasks</TD></TR><TR><TD ALIGN="LEFT"><B>MLP epochs</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">30, no early stop</TD><TD ALIGN="LEFT" BALIGN="LEFT">as min</TD><TD ALIGN="LEFT" BALIGN="LEFT">≤ 200, early stop</TD></TR><TR><TD ALIGN="LEFT"><B>GBDT</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">100 trees, depth 4, 64 bins</TD><TD ALIGN="LEFT" BALIGN="LEFT">as min</TD><TD ALIGN="LEFT" BALIGN="LEFT">200 trees, depth 6, 256 bins</TD></TR><TR><TD ALIGN="LEFT"><B>decision grid (RQ5 c)</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">off</TD><TD ALIGN="LEFT" BALIGN="LEFT">off</TD><TD ALIGN="LEFT" BALIGN="LEFT">on</TD></TR><TR><TD ALIGN="LEFT"><B>seeds × datasets</B></TD><TD ALIGN="LEFT" BALIGN="LEFT">10 × 9</TD><TD ALIGN="LEFT" BALIGN="LEFT">10 × 9</TD><TD ALIGN="LEFT" BALIGN="LEFT">10 × 9</TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="8">Each profile writes to data/processed/&lt;profile&gt;/ and artifacts/&lt;profile&gt;/; mid reuses min data. Method counts include 4 published results (vae_zseries and its<br/>seam-processing variants), which are not generated: 1 080 generated series in min (9 datasets × 10 seeds × 12 methods), 1 170 in mid (13), 2 790 in max (31 methods).</FONT></TD></TR></TABLE>>];
